DATABASE_URL=postgresql://farmhub:farmhub@localhost:55432/farmhub
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KetKat-EcoFarm
# Leave empty for local/root deployment. Use /smart-farm-management-system on cPanel subpath.
NEXT_PUBLIC_BASE_PATH=
# Optional static asset prefix for cPanel subpath builds. Deploy script sets this automatically.
NEXT_PUBLIC_ASSET_PREFIX=

# Use a long random value in production.
AUTH_SECRET=change-me-use-a-long-random-secret
NEXTAUTH_SECRET=change-me-use-a-long-random-secret

# Used by protected maintenance/refresh endpoints.
CRON_SECRET=change-me-cron-secret

# cPanel/Webmail settings for invitation/task emails.
# Create the mailbox in cPanel > Email Accounts, then use that mailbox here.
# If WEBMAIL_HOST is empty, the app will try mail.<domain-from-WEBMAIL_EMAIL>.
WEBMAIL_EMAIL=no-reply@example.com
WEBMAIL_PASSWORD=change-me-webmail-password
WEBMAIL_HOST=mail.example.com
WEBMAIL_PORT=465
WEBMAIL_SECURE=true
WEBMAIL_STARTTLS=false
WEBMAIL_TLS_REJECT_UNAUTHORIZED=true
MAIL_FROM=KetKat-EcoFarm <no-reply@example.com>

# Optional advanced SMTP fallback. WEBMAIL_* takes priority when present.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change-me

# Optional contact details shown in invitation email footer.
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+84 000 000 000
