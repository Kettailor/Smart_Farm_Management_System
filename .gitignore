# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =========================
# KetKat-EcoFarm .gitignore
# =========================

# Dependencies
/node_modules/
/.pnp
.pnp.js

# Package managers
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/

# Build outputs
/.next/
/deploy/
/out/
/build/
/dist/
*.zip
*.tar
*.tar.gz

# Coverage / test artifacts
/coverage/
*.lcov

# Caches
.npm/
.eslintcache
.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment files
.env
.env.*
!.env.example

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Security / certs
*.pem
*.key
*.crt
*.p12
*.pfx

# Runtime/user uploads
/public/uploads/

# Temporary files
*.tmp
*.temp

# Local folders not for versioning
UI-UX-Template_WebKetKat/

# AI / agent local files
/.agents/
/.codex/
/.cursor/
/.claude/
/.windsurf/
AGENTS.md
CLAUDE.md
.cursorrules
.cursorignore

# Host/deploy-only files and guides
/docs/GITHUB_SETUP.md
/docs/*DEPLOY*.md
/docs/CPANEL_DEPLOY.md
/scripts/prepare-cpanel-deploy.ps1
/scripts/import-postgresql-cpanel.sh
/database/*cpanel*.sql
/database/*demo*seed*.sql
